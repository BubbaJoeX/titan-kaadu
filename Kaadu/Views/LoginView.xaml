<UserControl x:Class="Kaadu.Views.LoginView"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
         xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
         xmlns:vm="clr-namespace:Kaadu.ViewModels"
         mc:Ignorable="d"
         d:DesignHeight="600" d:DesignWidth="900"
         d:DataContext="{d:DesignInstance Type=vm:LoginViewModel}">

<Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Login Card -->
        <Border Grid.Row="1" 
                Style="{StaticResource CardStyle}"
                MaxWidth="400"
                Margin="40">
            <StackPanel>
                <!-- Logo / Title -->
                <Image Source="/Assets/TITAN_LOGO.png"
                       Width="120"
                       Height="120"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,8"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                
                <TextBlock Text="SWG Titan"
                           Style="{StaticResource SubheadingStyle}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,32"/>

                <!-- Username -->
                <TextBlock Text="USERNAME"
                           Style="{StaticResource FormLabelStyle}"/>
                <TextBox x:Name="UsernameTextBox"
                         Style="{StaticResource ModernTextBoxStyle}"
                         Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,16"
                         KeyDown="Input_KeyDown"/>


                <!-- Password -->
                <TextBlock Text="PASSWORD"
                           Style="{StaticResource FormLabelStyle}"/>
                <PasswordBox x:Name="PasswordBox"
                             Style="{StaticResource ModernPasswordBoxStyle}"
                             PasswordChanged="PasswordBox_PasswordChanged"
                             KeyDown="Input_KeyDown"
                             Margin="0,0,0,24"/>

                <!-- Status Message -->
                <TextBlock x:Name="StatusText"
                           Text="{Binding StatusMessage, Mode=OneWay}"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,16">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource StatusTextStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Login Button -->
                <Button Content="LOGIN"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding LoginCommand}"
                        HorizontalAlignment="Stretch"
                        Margin="0,8,0,0"/>

                <!-- Loading Indicator -->
                <StackPanel Orientation="Horizontal" 
                            HorizontalAlignment="Center"
                            Margin="0,16,0,0"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Ellipse Width="8" Height="8" Fill="{StaticResource AccentBrush}" Margin="2">
                        <Ellipse.RenderTransform>
                            <ScaleTransform x:Name="LoadingDot1"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <Ellipse Width="8" Height="8" Fill="{StaticResource AccentBrush}" Margin="2"/>
                    <Ellipse Width="8" Height="8" Fill="{StaticResource AccentBrush}" Margin="2"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Footer -->
        <Border Grid.Row="3"
                Background="{StaticResource SecondaryBackgroundBrush}"
                Opacity="0.9"
                Padding="24,12">
            <Grid>
                <StackPanel Orientation="Horizontal" 
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center">
                    <TextBlock Text="© 2026 SWG Titan"
                               Style="{StaticResource StatusTextStyle}"
                               FontSize="11"
                               Opacity="0.5"/>
                    <TextBlock Text="  •  "
                               Style="{StaticResource StatusTextStyle}"
                               FontSize="11"
                               Opacity="0.3"/>
                    <TextBlock Text="v1.0.0"
                               Style="{StaticResource StatusTextStyle}"
                               FontSize="11"
                               Opacity="0.5"/>
                </StackPanel>
                <TextBlock Text="swgtitan.org"
                           Style="{StaticResource StatusTextStyle}"
                           FontSize="11"
                           Foreground="{StaticResource AccentBrush}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Cursor="Hand"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
