<Window x:Class="Kaadu.MainWindow"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
xmlns:local="clr-namespace:Kaadu"
xmlns:views="clr-namespace:Kaadu.Views"
xmlns:vm="clr-namespace:Kaadu.ViewModels"
mc:Ignorable="d"
Title="Titan Launcher" 
Height="800" 
Width="1200"
MinHeight="600"
MinWidth="900"
WindowStyle="None"
AllowsTransparency="True"
Background="Transparent"
WindowStartupLocation="CenterScreen"
ResizeMode="CanResizeWithGrip"
Icon="Assets/TITAN_LOGO.ico">

    <Window.Resources>
        <!-- DataTemplates for View switching -->
        <DataTemplate DataType="{x:Type vm:LoginViewModel}">
            <views:LoginView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LauncherViewModel}">
            <views:LauncherView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AdminViewModel}">
            <views:AdminView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:InstallPathViewModel}">
            <views:InstallPathView/>
        </DataTemplate>
    </Window.Resources>

    <Border Background="Transparent"
            CornerRadius="12"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.5"/>
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="337*"/>
                <ColumnDefinition Width="262*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <!-- Background Video -->
            <MediaElement x:Name="BackgroundVideo"
                          Grid.RowSpan="2"
                          Source="https://swgtitan.org/videos/swgor_bg_720.mp4"
                          LoadedBehavior="Manual"
                          UnloadedBehavior="Stop"
                          Stretch="UniformToFill"
                          IsMuted="True"
                          MediaEnded="BackgroundVideo_MediaEnded" Grid.ColumnSpan="2"/>

            <!-- Background Audio (separate for independent control) -->
            <MediaElement x:Name="BackgroundAudio"
                          LoadedBehavior="Manual"
                          UnloadedBehavior="Stop"
                          Source="https://swgtitan.org/audio/music_autorun_new_lp.mp3"
                          Volume="0.3"
                          MediaEnded="BackgroundAudio_MediaEnded"
                          Visibility="Collapsed" Grid.ColumnSpan="2"/>

            <!-- Semi-transparent overlay for better readability -->
            <Border Grid.RowSpan="2" 
                    Background="{StaticResource PrimaryBackgroundBrush}"
                    Opacity="0.6" Grid.ColumnSpan="2"/>

            <!-- Custom Title Bar -->
            <Grid Grid.Row="0" 
                  Background="{StaticResource SecondaryBackgroundBrush}"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Grid.ColumnSpan="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Title -->
                <StackPanel Grid.Column="0" 
                            Orientation="Horizontal" 
                            VerticalAlignment="Center"
                            Margin="12,0,0,0">
                    <Image Source="Assets/TITAN_LOGO.png"
                           Width="22" Height="23" RenderTransformOrigin="0.746,-0.089"
                           />
                </StackPanel>

                <!-- Window Controls -->
                <StackPanel Grid.Column="1" 
                            Orientation="Horizontal">
                    <!-- Mute Button -->
                    <Button x:Name="MuteButton"
                            Style="{StaticResource IconButtonStyle}"
                            Click="MuteButton_Click"
                            ToolTip="Toggle music">
                        <TextBlock x:Name="MuteIcon" Text="🔊" FontSize="12"/>
                    </Button>
                    <Button x:Name="MinimizeButton"
                            Style="{StaticResource IconButtonStyle}"
                            Click="MinimizeButton_Click">
                        <TextBlock Text="-" FontSize="12"/>
                    </Button>
                    <Button x:Name="MaximizeButton"
                            Style="{StaticResource IconButtonStyle}"
                            Click="MaximizeButton_Click">
                        <TextBlock Text="O" FontSize="12"/>
                    </Button>
                    <Button x:Name="CloseButton"
                            Style="{StaticResource CloseButtonStyle}"
                            Click="CloseButton_Click">
                        <TextBlock Text="✕" FontSize="12"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Main Content Area -->
            <ContentControl Grid.Row="1" 
                            Content="{Binding CurrentViewModel}" Grid.ColumnSpan="2"/>

            <!-- Resize Grip -->
            <ResizeGrip Grid.Row="1"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Cursor="SizeNWSE"
                        Opacity="0.3" Grid.Column="1"/>
        </Grid>
    </Border>
</Window>
