<UserControl x:Class="Kaadu.Views.LauncherView"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
xmlns:vm="clr-namespace:Kaadu.ViewModels"
mc:Ignorable="d"
d:DesignHeight="600" d:DesignWidth="900"
d:DataContext="{d:DesignInstance Type=vm:LauncherViewModel}">

    <Grid Background="{StaticResource PrimaryBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" 
                Background="{StaticResource SecondaryBackgroundBrush}"
                Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- User Info -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="40" Height="40" Fill="{StaticResource TertiaryBackgroundBrush}">
                        <Ellipse.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="0" Opacity="0.3"/>
                        </Ellipse.Effect>
                    </Ellipse>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Username}"
                                   Style="{StaticResource StatusTextStyle}"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="Welcome back!"
                                   Style="{StaticResource StatusTextStyle}"
                                   FontSize="12"
                                   Opacity="0.7"/>
                    </StackPanel>
                </StackPanel>

                <!-- Header Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="⚙ Admin"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding OpenAdminCommand}"
                            Visibility="{Binding ShowAdminButton, Converter={StaticResource BoolToVisibilityConverter}}"
                            Padding="16,8"
                            Margin="0,0,12,0"/>
                    <Button Content="Logout"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding LogoutCommand}"
                            Padding="16,8"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="40">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Game Branding Area -->
            <StackPanel Grid.Row="0" 
                        VerticalAlignment="Center" 
                        HorizontalAlignment="Center">
                
                <!-- Logo -->
                <TextBlock Text="KAADU"
                           FontSize="72"
                           FontWeight="Bold"
                           HorizontalAlignment="Center">
                    <TextBlock.Foreground>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="{StaticResource AccentColor}" Offset="0"/>
                            <GradientStop Color="#FF0077B6" Offset="1"/>
                        </LinearGradientBrush>
                    </TextBlock.Foreground>
                    <TextBlock.Effect>
                        <DropShadowEffect Color="{StaticResource AccentColor}" 
                                          BlurRadius="30" 
                                          ShadowDepth="0" 
                                          Opacity="0.5"/>
                    </TextBlock.Effect>
                </TextBlock>

                <TextBlock Text="SWG Titan"
                           Style="{StaticResource SubheadingStyle}"
                           FontSize="20"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,32"/>

                <!-- Version Info -->
                <Border Background="{StaticResource SecondaryBackgroundBrush}"
                        CornerRadius="8"
                        Padding="24,12"
                        HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Version: "
                                   Style="{StaticResource StatusTextStyle}"/>
                        <TextBlock Text="{Binding CurrentVersion}"
                                   Style="{StaticResource StatusTextStyle}"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text=" → "
                                   Style="{StaticResource StatusTextStyle}"
                                   Visibility="{Binding IsUpdating, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <TextBlock Text="{Binding LatestVersion}"
                                   Style="{StaticResource StatusTextStyle}"
                                   Foreground="{StaticResource SuccessBrush}"
                                   FontWeight="SemiBold"
                                   Visibility="{Binding IsUpdating, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Bottom Section -->
            <StackPanel Grid.Row="1">
                <!-- Unified Status & Progress Section -->
                <StackPanel Margin="0,0,0,24">
                    <!-- Status Message -->
                    <TextBlock Text="{Binding StatusMessage}"
                               Style="{StaticResource StatusTextStyle}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,12"/>
                    
                    <!-- Progress Bar (only visible when updating) -->
                    <Grid Visibility="{Binding IsUpdating, Converter={StaticResource BoolToVisibilityConverter}}"
                          MaxWidth="400"
                          HorizontalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <ProgressBar Style="{StaticResource ModernProgressBarStyle}"
                                         Value="{Binding Progress}"
                                         Maximum="100"
                                         Height="8"/>
                            <TextBlock Text="{Binding Progress, StringFormat={}{0:F0}%}"
                                       Style="{StaticResource StatusTextStyle}"
                                       FontSize="11"
                                       HorizontalAlignment="Right"
                                       Margin="0,-20,0,0"
                                       Opacity="0.7"/>
                        </Grid>
                        
                        <Button Grid.Row="1"
                                Content="Cancel"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding CancelUpdateCommand}"
                                HorizontalAlignment="Center"
                                Padding="16,6"
                                FontSize="12"/>
                    </Grid>
                </StackPanel>

                <!-- Character Selection (if characters available) -->
                <StackPanel Orientation="Horizontal" 
                            HorizontalAlignment="Center"
                            Margin="0,0,0,16"
                            Visibility="{Binding HasCharacters, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="Character: "
                               Style="{StaticResource StatusTextStyle}"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"/>
                    <ComboBox ItemsSource="{Binding Characters}"
                              SelectedItem="{Binding SelectedCharacter}"
                              DisplayMemberPath="DisplayName"
                              MinWidth="200"
                              Padding="12,8"
                              Background="{StaticResource SecondaryBackgroundBrush}"
                              Foreground="{StaticResource TextPrimaryBrush}"
                              BorderBrush="{StaticResource AccentBrush}"
                              BorderThickness="1"/>
                </StackPanel>

                <!-- Setup Button (first-time only) -->
                <Button Content="⚙ Run Setup"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding OpenSetupCommand}"
                        HorizontalAlignment="Center"
                        MinWidth="200"
                        Margin="0,0,0,16"
                        Visibility="{Binding ShowSetupButton, Converter={StaticResource BoolToVisibilityConverter}}"/>

                <!-- Play Button -->
                <Button Content="PLAY"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding PlayCommand}"
                        HorizontalAlignment="Center"
                        MinWidth="200"
                        Visibility="{Binding CanPlay, Converter={StaticResource BoolToVisibilityConverter}}"/>

                <!-- Check for Updates Button -->
                <Button Content="Check for Updates"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding CheckForUpdatesCommand}"
                        HorizontalAlignment="Center"
                        Margin="0,16,0,0"
                        Padding="20,10"
                        Visibility="{Binding IsUpdating, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"/>
            </StackPanel>

            <!-- Admin Console (visible only for admins) -->
            <Border Grid.Row="2"
                    Background="{StaticResource SecondaryBackgroundBrush}"
                    CornerRadius="8"
                    Margin="0,24,0,0"
                    MaxHeight="150"
                    Visibility="{Binding ShowAdminConsole, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Console Header -->
                    <Border Grid.Row="0" 
                            Background="{StaticResource TertiaryBackgroundBrush}"
                            CornerRadius="8,8,0,0"
                            Padding="12,8">
                        <TextBlock Text="📋 Admin Console"
                                   Style="{StaticResource StatusTextStyle}"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentBrush}"/>
                    </Border>
                    
                    <!-- Console Output -->
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding ConsoleLog}"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="8"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             x:Name="ConsoleListBox">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"
                                           FontFamily="Consolas"
                                           FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           TextWrapping="Wrap"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0,2"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Focusable" Value="False"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2"
                Background="{StaticResource SecondaryBackgroundBrush}"
                Padding="24,12">
            <Grid>
                <TextBlock Text="© 2024 SWG Titan"
                           Style="{StaticResource StatusTextStyle}"
                           FontSize="12"
                           Opacity="0.5"
                           HorizontalAlignment="Left"/>
                <TextBlock Text="swgtitan.org"
                           Style="{StaticResource StatusTextStyle}"
                           FontSize="12"
                           Foreground="{StaticResource AccentBrush}"
                           HorizontalAlignment="Right"
                           Cursor="Hand"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
